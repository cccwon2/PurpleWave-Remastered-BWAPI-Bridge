From cdcb5d869a0e3136cfa0d3b1da53c64084b8c677 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 16 Nov 2026 21:17:32 +0000
Subject: [PATCH] Resolve null game.self at MatchStart; retry init from
 onFrame.

Players.get NPEd when JBWAPI left Game.self null (isReplay / torn
GameData). Resolve self via Snapshot mineral fingerprint, null-safe
Players.get, defer onFrame retry until With.ready, and honor
-Dpurplewave.jbwapi.sync=true for Remaster (Probe-like sync).
---
 src/Lifecycle/Main.scala             |  8 +++-
 src/Lifecycle/PurpleWave.scala       | 40 ++++++++++------
 src/Lifecycle/With.scala             | 71 ++++++++++++++++++++++++----
 src/ProxyBwapi/Players/Players.scala | 21 +++++++-
 4 files changed, 113 insertions(+), 27 deletions(-)

diff --git a/src/Lifecycle/Main.scala b/src/Lifecycle/Main.scala
index be3b19104..8e5ec8507 100644
--- a/src/Lifecycle/Main.scala
+++ b/src/Lifecycle/Main.scala
@@ -14,8 +14,13 @@ object Main {
   private val memoryFree  : Long            = Math.min(Runtime.getRuntime.maxMemory, Runtime.getRuntime.totalMemory)
   val jvmRuntimeArguments : Vector[String]  = ManagementFactory.getRuntimeMXBean.getInputArguments.asScala.toVector
   val liveDebugging       : Boolean         = jvmRuntimeArguments.exists(_.contains("purpledebug"))
+  // Remaster/JBWAPI server: prefer sync (matches ConnectionProbe). Async unsafe
+  // can tear GameData bools (isReplay) and leave Game.self null at MatchStart.
+  val forceSync           : Boolean         =
+    jvmRuntimeArguments.exists(_.contains("purplewave.jbwapi.sync=true")) ||
+      Option(System.getProperty("purplewave.jbwapi.sync")).exists(v => v == "true" || v == "1")
   val framesBufferable    : Int             = ((memoryFree - botRequiredDataSizeBytes) / JBWAPIClientDataSizeBytes).toInt
-  val useFrameBuffer      : Boolean         = ! liveDebugging
+  val useFrameBuffer      : Boolean         = ! liveDebugging && ! forceSync
   val framesToBuffer      : Int             = ?(useFrameBuffer, Maff.clamp(framesBufferable, 1, 10), 0)
 
   val jbwapiConfiguration: BWClientConfiguration = new BWClientConfiguration()
@@ -28,6 +33,7 @@ object Main {
 
   def main(args: Array[String]): Unit = {
     System.out.println(f"PurpleWave Main.main() invoked ${System.currentTimeMillis() - ManagementFactory.getRuntimeMXBean.getStartTime}ms after VM start.")
+    System.out.println(f"JBWAPI async=${useFrameBuffer} forceSync=$forceSync framesToBuffer=$framesToBuffer")
     PurpleBWClient.startGame(jbwapiConfiguration)
   }
 }
diff --git a/src/Lifecycle/PurpleWave.scala b/src/Lifecycle/PurpleWave.scala
index 3b9168c97..04e94c626 100644
--- a/src/Lifecycle/PurpleWave.scala
+++ b/src/Lifecycle/PurpleWave.scala
@@ -18,25 +18,35 @@ class PurpleWave extends DefaultBWListener {
 
   override def onStart(): Unit = {
     With.frame0ms = 0
-    timeFrameZero(() => {
-      tryCatch(() => {
-        With.onStart()
-        Walls.logInfo = With.configuration.logstd
-        JBWEBWrapper.onStart()
-        With.history.onStart()
-        With.units.onStart()
-        With.grids.creep.update()
-        With.geography.onStart()
-      })})
+    timeFrameZero(() => tryCatch(() => runFullStart()))
+  }
+
+  /** Full bot init after MatchStart (or deferred from onFrame when self was null). */
+  private def runFullStart(): Unit = {
+    With.onStart()
+    Walls.logInfo = With.configuration.logstd
+    JBWEBWrapper.onStart()
+    With.history.onStart()
+    With.units.onStart()
+    With.grids.creep.update()
+    With.geography.onStart()
   }
 
   override def onFrame(): Unit = {
-    // MatchStart → onStart must finish before MatchFrame. If init failed
-    // (or never ran), skip so tryCatch does not NPE on a null With.logger.
+    // If MatchStart onStart failed (e.g. game.self null before Snapshot self
+    // fingerprint was readable), retry init once players are resolvable.
     if (!With.ready) {
-      System.err.println(
-        "[PurpleWave] onFrame skipped: With.ready=false (wait for MatchStart/onStart to finish)")
-      return
+      tryCatch(() => {
+        if (PurpleBWClient.getGame != null && PurpleBWClient.getGame.isInGame) {
+          System.err.println("[PurpleWave] With.ready=false — retrying onStart from onFrame")
+          runFullStart()
+        }
+      })
+      if (!With.ready) {
+        System.err.println(
+          "[PurpleWave] onFrame skipped: With.ready=false (self/players not ready yet)")
+        return
+      }
     }
     timeFrameZero(() => {
       tryCatch(() => {
diff --git a/src/Lifecycle/With.scala b/src/Lifecycle/With.scala
index 2efb7a407..ff6f3f68f 100644
--- a/src/Lifecycle/With.scala
+++ b/src/Lifecycle/With.scala
@@ -135,32 +135,37 @@ object With {
     game.setLatCom(false)
     game.setLocalSpeed(0)
 
+    // Logger before player resolution so tryCatch / deferred init can report.
+    bwapiData         = new BwapiData
+    configuration     = new Configuration
+    logger            = new Logger
+
     ////////////////
     // Basic data //
     ////////////////
 
     // JBWAPI EventHandler calls onStart on MatchStart before UnitDiscover, so
     // Player.getUnits() is empty here under Remaster Snapshot + JBWAPI.
+    // If isReplay is wrongly set in GameData, Game.self is null — resolve via
+    // Snapshot's resource fingerprint (only local self has minerals filled).
     frame             = 0
     proxy             = new ProxyBWAPI
-    self              = Players.get(game.self)
-    neutral           = Players.get(game.neutral)
